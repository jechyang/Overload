    "AbiMismatch": 1,
    "InvalidArgument": 2,
    "WrongThread": 3,
    "SessionNotFound": 4,
    "SessionClosing": 5,
    "SessionFaulted": 6,
    "TypeNotFound": 7,
    "DuplicateIdentity": 8,
    "InstanceNotFound": 9,
    "InstanceFaulted": 10,
    "InvalidLifecycle": 11,
    "FieldNotFound": 12,
    "FieldTypeMismatch": 13,
    "UnsupportedField": 14,
    "ManagedException": 15,
    "BufferOwnership": 16,
    "NativeAbiMismatch": 17,
    "Busy": 18
  },
  "lifecycle_codes": {
    "Awake": 1,
    "Start": 2,
    "Enable": 3,
    "Disable": 4,
    "Update": 5,
    "FixedUpdate": 6,
    "LateUpdate": 7,
    "CollisionEnter": 8,
    "CollisionStay": 9,
    "CollisionExit": 10,
    "TriggerEnter": 11,
    "TriggerStay": 12,
    "TriggerExit": 13,
    "Destroy": 14,
    "ReloadRestore": 15
  },
  "field_tags": {
    "Bool": 1,
    "Int8": 2,
    "UInt8": 3,
    "Int16": 4,
    "UInt16": 5,
    "Int32": 6,
    "UInt32": 7,
    "Int64": 8,
    "UInt64": 9,
    "Float32": 10,
    "Float64": 11,
    "String": 12,
    "EnumInt64": 13,
    "EnumUInt64": 14,
    "Vector3": 15,
    "Quaternion": 16,
    "ActorRef": 17,
    "AssetRef": 18
  },
  "table_entries": [
    "release_owned_utf8",
    "release_field_value",
    "take_last_error",
    "create_session",
    "close_session",
    "bind_native_api",
    "get_type_count",
    "get_type_info",
    "get_type_alias",
    "release_type_info",
    "get_field_info",
    "get_field_alias",
    "release_field_info",
    "create_instance",
    "destroy_instance",
    "dispatch_lifecycle",
    "read_field",
    "write_field"
