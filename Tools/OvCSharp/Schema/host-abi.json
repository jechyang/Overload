  "identity": {
    "default_key": [
      "backend",
      "assembly_logical_name",
      "canonical_type_name"
    ],
    "backend_values": [
      "lua",
      "csharp"
    ],
    "explicit_stable_id": true,
    "old_identity_aliases": true,
    "assembly_qualified_name_is_persistent": false,
    "lua_legacy_path_is_readable": true
  },
  "ownership": {
    "input_views": "borrowed_for_call",
    "output_utf8": "managed_owned_until_release_owned_utf8",
    "output_field_value": "managed_owned_until_release_field_value",
    "type_info": "managed_owned_until_release_type_info",
    "field_info": "managed_owned_until_release_field_info",
    "zero_length_utf8": "null_pointer_allowed",
    "nonzero_length_utf8": "non_null_pointer_required"
  },
  "threading": {
    "all_entries": "captured_main_thread",
    "calls": "synchronous",
