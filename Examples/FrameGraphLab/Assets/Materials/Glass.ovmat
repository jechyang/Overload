<root><shader>:Shaders/Standard.ovfx</shader><settings><support_orthographic>true</support_orthographic><support_perspective>true</support_perspective><blendable>true</blendable><backface_culling>false</backface_culling><frontface_culling>false</frontface_culling><depth_test>true</depth_test><depth_writing>false</depth_writing><color_writing>true</color_writing><cast_shadows>false</cast_shadows><receive_shadows>false</receive_shadows><receive_reflections>false</receive_reflections><user_interface>false</user_interface><gpu_instances>1</gpu_instances><draw_order>110</draw_order></settings><uniforms><uniform><name>u_Albedo</name><value><x>0.1</x><y>0.65</y><z>0.82</z><w>0.28</w></value></uniform><uniform><name>u_Metallic</name><value>0.05</value></uniform><uniform><name>u_Roughness</name><value>0.1</value></uniform><uniform><name>u_EmissiveColor</name><value><x>0</x><y>0</y><z>0</z></value></uniform><uniform><name>u_EmissiveIntensity</name><value>0</value></uniform><uniform><name>u_BuiltInToneMapping</name><value>false</value></uniform><uniform><name>u_BuiltInGammaCorrection</name><value>false</value></uniform></uniforms><features/></root>
